{
  "name": "rail-prism-mvp",
  "version": "1.0.0",
  "description": "AI-Assisted Railway Decision Support System MVP",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "./start-mvp.sh",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "build": "cd frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "railway",
    "ai",
    "optimization",
    "decision-support",
    "kafka",
    "mongodb",
    "react",
    "nodejs"
  ],
  "author": "RAIL-PRISM Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/rail-prism-mvp.git"
  }
}