# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (MongoDB Atlas)
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rail_prism?retryWrites=true&w=majority
MONGODB_DB_NAME=rail_prism

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rail-prism-backend
KAFKA_GROUP_ID=rail-prism-group

# Topics
KAFKA_TRAIN_POSITIONS_TOPIC=train-positions
KAFKA_TRAIN_EVENTS_TOPIC=train-events
KAFKA_OPTIMIZATION_RESULTS_TOPIC=optimization-results

# Optimization Engine
OPTIMIZATION_TIMEOUT_MS=5000
MAX_CONFLICTS_PER_BATCH=10

# WebSocket Configuration
WS_PORT=3002

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
JWT_SECRET=your-super-secret-jwt-key
API_RATE_LIMIT=100